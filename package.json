{
  "name": "prontuario-pessoal",
  "productName": "Helyx",
  "version": "1.10.0",
  "description": "Gestão Pessoal de Saúde — prontuário pessoal inteligente",
  "author": "almircs",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "app": "electron .",
    "backup": "node --disable-warning=ExperimentalWarning server/scripts/backup.js",
    "demo": "node --disable-warning=ExperimentalWarning server/scripts/demo.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=4 test/*.test.js",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac dir --x64 --arm64 --publish never",
    "build:celular": "node mobile/build.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@tesseract.js-data/por": "1.0.0",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "path-browserify": "1.0.1",
    "sql.js": "1.14.2",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.helyx.app",
    "productName": "Helyx",
    "copyright": "Helyx",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "electron/**",
      "server/**",
      "!server/scripts/demo.js",
      "public/**",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!node_modules/pdfjs-dist/{build,web,types,image_decoders,iccs}/**",
      "!node_modules/pdfjs-dist/legacy/{image_decoders,web}/**",
      "!node_modules/pdfjs-dist/legacy/build/{pdf.mjs,pdf.worker.mjs,pdf.sandbox*,*.d.mts}",
      "!node_modules/@tesseract.js-data/por/4.0.0/**",
      "!node_modules/tesseract.js-core/tesseract-core{,-simd,-relaxedsimd}.{js,wasm,wasm.js}",
      "!node_modules/tesseract.js-core/tesseract-core*-lstm.{js,wasm}",
      "!node_modules/tesseract.js/{src,docs,benchmarks,scripts,tests,examples}/**",
      "!node_modules/@napi-rs/**"
    ],
    "asar": true,
    "asarUnpack": ["**/*.node"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "executableName": "Helyx"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Helyx",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["pt_BR"],
      "language": "1046",
      "artifactName": "Instalar-Helyx-Windows.${ext}"
    },
    "mac": {
      "category": "public.app-category.medical",
      "icon": "build/icon.png",
      "identity": null,
      "target": ["dir"]
    }
  }
}
